    local CONFIG = {
        AUTO_JJ_ENABLED = false,
        AUTO_JJ_DELAY = 0.7,
        AUTO_JJ_KEYS = {Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.W, Enum.KeyCode.Space, Enum.KeyCode.E, Enum.KeyCode.Q},

