createRecorderContent = function(parent)
    -- Cabeçalho com logo e status
    local header = Instance.new("Frame")
    header.Size = UDim2.new(1, -24, 0, 50)
    header.Position = UDim2.new(0, 12, 0, 12)
    header.BackgroundColor3 = T.BgPanel
    header.BorderSizePixel = 0
    header.Parent = parent
    applyCorner(header, 10)
    applyStroke(header, T.Border, 1)

    local logo = Instance.new("TextLabel")
    logo.Size = UDim2.new(1, -20, 1, 0)
    logo.Position = UDim2.new(0, 12, 0, 0)
    logo.BackgroundTransparency = 1
    logo.Text = "UMR  ·  Universal Movement Recorder"
    logo.TextColor3 = T.Accent
    logo.Font = Enum.Font.GothamBold
    logo.TextSize = 14
    logo.TextXAlignment = Enum.TextXAlignment.Left
    logo.Parent = header

    -- Status indicator (ponto pulsante)
    recDot = Instance.new("Frame")
    recDot.Size = UDim2.new(0, 8, 0, 8)
    recDot.Position = UDim2.new(1, -20, 0.5, -4)
    recDot.BackgroundColor3 = T.Danger
    recDot.BorderSizePixel = 0
    recDot.Visible = false
    recDot.Parent = header
    applyCorner(recDot, 4)

    task.spawn(function()
        while recDot and recDot.Parent do
            if recDot.Visible then
                TweenService:Create(recDot, TweenInfo.new(0.5), {BackgroundTransparency = 0.6}):Play()
                task.wait(0.5)
                if recDot and recDot.Parent then
                    TweenService:Create(recDot, TweenInfo.new(0.5), {BackgroundTransparency = 0}):Play()
                end
            end
            task.wait(0.1)
        end
    end)

    -- ====== Controles principais (linha de botões) ======
    local controls = Instance.new("Frame")
    controls.Size = UDim2.new(1, -24, 0, 60)
    controls.Position = UDim2.new(0, 12, 0, 70)
    controls.BackgroundTransparency = 1
    controls.Parent = parent

    -- Botão Record
    recBtn = Instance.new("TextButton")
    recBtn.Size = UDim2.new(0.32, -4, 1, 0)
    recBtn.Position = UDim2.new(0, 0, 0, 0)
    recBtn.BackgroundColor3 = T.Danger
    recBtn.Text = "●  REC"
    recBtn.TextColor3 = T.Text
    recBtn.Font = Enum.Font.GothamBold
    recBtn.TextSize = 14
    recBtn.Parent = controls
    applyCorner(recBtn, 10)
    recBtn.MouseButton1Click:Connect(function()
        if isRecording then
            stopRecording()
            recBtn.Text = "●  REC"
            TweenService:Create(recBtn, TweenInfo.new(0.2), {BackgroundColor3 = T.Danger}):Play()
        else
            startRecording()
            recBtn.Text = "■  STOP"
            TweenService:Create(recBtn, TweenInfo.new(0.2), {BackgroundColor3 = T.Warning}):Play()
        end
    end)

    -- Botão Play/Pause
    playBtn = Instance.new("TextButton")
    playBtn.Size = UDim2.new(0.32, -4, 1, 0)
    playBtn.Position = UDim2.new(0.34, 0, 0, 0)
    playBtn.BackgroundColor3 = T.Accent
    playBtn.Text = "▶  PLAY"
    playBtn.TextColor3 = T.BgDeep
    playBtn.Font = Enum.Font.GothamBold
    playBtn.TextSize = 14
    playBtn.Parent = controls
    applyCorner(playBtn, 10)
    playBtn.MouseButton1Click:Connect(function()
        if isPlaying and not isPaused then
            -- Pausa
            startPlayback()
            playBtn.Text = "▶  RESUME"
            TweenService:Create(playBtn, TweenInfo.new(0.2), {BackgroundColor3 = T.Warning, TextColor3 = T.Text}):Play()
        elseif isPlaying and isPaused then
            -- Retoma
            startPlayback()
            playBtn.Text = "⏸  PAUSE"
            TweenService:Create(playBtn, TweenInfo.new(0.2), {BackgroundColor3 = T.Accent, TextColor3 = T.BgDeep}):Play()
        else
            -- Inicia
            startPlayback()
            if isPlaying then
                playBtn.Text = "⏸  PAUSE"
                TweenService:Create(playBtn, TweenInfo.new(0.2), {BackgroundColor3 = T.Accent, TextColor3 = T.BgDeep}):Play()
            end
        end
    end)

    -- Botão Stop
    local stopBtn = Instance.new("TextButton")
    stopBtn.Size = UDim2.new(0.32, -4, 1, 0)
    stopBtn.Position = UDim2.new(0.68, 0, 0, 0)
    stopBtn.BackgroundColor3 = T.BgElevated
    stopBtn.Text = "■  STOP"
    stopBtn.TextColor3 = T.Text
    stopBtn.Font = Enum.Font.GothamBold
    stopBtn.TextSize = 14
    stopBtn.Parent = controls
    applyCorner(stopBtn, 10)
    stopBtn.MouseButton1Click:Connect(function()
        stopRecording()
        stopPlayback()
        recBtn.Text = "●  REC"
        TweenService:Create(recBtn, TweenInfo.new(0.2), {BackgroundColor3 = T.Danger}):Play()
        playBtn.Text = "▶  PLAY"
        TweenService:Create(playBtn, TweenInfo.new(0.2), {BackgroundColor3 = T.Accent, TextColor3 = T.BgDeep}):Play()
    end)

    -- ====== Barra de progresso ======
    local progBox = Instance.new("Frame")
    progBox.Size = UDim2.new(1, -24, 0, 20)
    progBox.Position = UDim2.new(0, 12, 0, 140)
    progBox.BackgroundColor3 = T.BgPanel
    progBox.BorderSizePixel = 0
    progBox.Parent = parent
    applyCorner(progBox, 10)

    progressFill = Instance.new("Frame")
    progressFill.Size = UDim2.new(0, 0, 1, 0)
    progressFill.BackgroundColor3 = T.Accent
    progressFill.BorderSizePixel = 0
    progressFill.Parent = progBox
    applyCorner(progressFill, 10)

    progressLabel = Instance.new("TextLabel")
    progressLabel.Size = UDim2.new(1, 0, 1, 0)
    progressLabel.BackgroundTransparency = 1
    progressLabel.Text = "0 / 0"
    progressLabel.TextColor3 = T.Text
    progressLabel.Font = Enum.Font.GothamMedium
    progressLabel.TextSize = 10
    progressLabel.Parent = progBox

    -- ====== Linha de opções (Loop, Speed) ======
    local opts1 = Instance.new("Frame")
    opts1.Size = UDim2.new(1, -24, 0, 36)
    opts1.Position = UDim2.new(0, 12, 0, 170)
    opts1.BackgroundTransparency = 1
    opts1.Parent = parent

    local loopBtn = Instance.new("TextButton")
    loopBtn.Size = UDim2.new(0.48, -4, 1, 0)
    loopBtn.Position = UDim2.new(0, 0, 0, 0)
    loopBtn.BackgroundColor3 = CONFIG.LOOP_PLAYBACK and T.Success or T.BgElevated
    loopBtn.Text = "🔁  Loop: " .. (CONFIG.LOOP_PLAYBACK and "ON" or "OFF")
    loopBtn.TextColor3 = T.Text
    loopBtn.Font = Enum.Font.GothamMedium
    loopBtn.TextSize = 12
    loopBtn.Parent = opts1
    applyCorner(loopBtn, 8)
    loopBtn.MouseButton1Click:Connect(function()
        CONFIG.LOOP_PLAYBACK = not CONFIG.LOOP_PLAYBACK
        loopBtn.Text = "🔁  Loop: " .. (CONFIG.LOOP_PLAYBACK and "ON" or "OFF")
        TweenService:Create(loopBtn, TweenInfo.new(0.15), {BackgroundColor3 = CONFIG.LOOP_PLAYBACK and T.Success or T.BgElevated}):Play()
    end)

    local speedBox = Instance.new("Frame")
    speedBox.Size = UDim2.new(0.48, -4, 1, 0)
    speedBox.Position = UDim2.new(0.52, 0, 0, 0)
    speedBox.BackgroundColor3 = T.BgElevated
    speedBox.BorderSizePixel = 0
    speedBox.Parent = opts1
    applyCorner(speedBox, 8)

    local speedMinus = Instance.new("TextButton")
    speedMinus.Size = UDim2.new(0, 28, 1, 0)
    speedMinus.BackgroundTransparency = 1
    speedMinus.Text = "−"
    speedMinus.TextColor3 = T.Accent
    speedMinus.Font = Enum.Font.GothamBold
    speedMinus.TextSize = 16
    speedMinus.Parent = speedBox

    local speedLabel = Instance.new("TextLabel")
    speedLabel.Size = UDim2.new(1, -56, 1, 0)
    speedLabel.Position = UDim2.new(0, 28, 0, 0)
    speedLabel.BackgroundTransparency = 1
    speedLabel.Text = string.format("%.1fx", CONFIG.PLAYBACK_SPEED)
    speedLabel.TextColor3 = T.Text
    speedLabel.Font = Enum.Font.GothamMedium
    speedLabel.TextSize = 12
    speedLabel.Parent = speedBox

    local speedPlus = Instance.new("TextButton")
    speedPlus.Size = UDim2.new(0, 28, 1, 0)
    speedPlus.Position = UDim2.new(1, -28, 0, 0)
    speedPlus.BackgroundTransparency = 1
    speedPlus.Text = "+"
    speedPlus.TextColor3 = T.Accent
    speedPlus.Font = Enum.Font.GothamBold
    speedPlus.TextSize = 16
    speedPlus.Parent = speedBox

    local function updateSpeed(d)
        CONFIG.PLAYBACK_SPEED = math.clamp(CONFIG.PLAYBACK_SPEED + d, 0.5, 2.0)
        speedLabel.Text = string.format("%.1fx", CONFIG.PLAYBACK_SPEED)
    end
    speedMinus.MouseButton1Click:Connect(function() updateSpeed(-0.1) end)
    speedPlus.MouseButton1Click:Connect(function() updateSpeed(0.1) end)

    -- ====== Linha de opções (Noclip, Camera Sync) ======
    local opts2 = Instance.new("Frame")
    opts2.Size = UDim2.new(1, -24, 0, 36)
    opts2.Position = UDim2.new(0, 12, 0, 212)
    opts2.BackgroundTransparency = 1
    opts2.Parent = parent

    local noclipBtn = Instance.new("TextButton")
    noclipBtn.Size = UDim2.new(0.48, -4, 1, 0)
    noclipBtn.Position = UDim2.new(0, 0, 0, 0)
    noclipBtn.BackgroundColor3 = CONFIG.NOCLIP_ENABLED and T.Success or T.BgElevated
    noclipBtn.Text = "🚪  Noclip: " .. (CONFIG.NOCLIP_ENABLED and "ON" or "OFF")
    noclipBtn.TextColor3 = T.Text
    noclipBtn.Font = Enum.Font.GothamMedium
    noclipBtn.TextSize = 12
    noclipBtn.Parent = opts2
    applyCorner(noclipBtn, 8)
    noclipBtn.MouseButton1Click:Connect(function()
        CONFIG.NOCLIP_ENABLED = not CONFIG.NOCLIP_ENABLED
        noclipBtn.Text = "🚪  Noclip: " .. (CONFIG.NOCLIP_ENABLED and "ON" or "OFF")
        TweenService:Create(noclipBtn, TweenInfo.new(0.15), {BackgroundColor3 = CONFIG.NOCLIP_ENABLED and T.Success or T.BgElevated}):Play()
    end)

    local syncBtn = Instance.new("TextButton")
    syncBtn.Size = UDim2.new(0.48, -4, 1, 0)
    syncBtn.Position = UDim2.new(0.52, 0, 0, 0)
    syncBtn.BackgroundColor3 = CONFIG.SYNC_CAMERA and T.Success or T.BgElevated
    syncBtn.Text = "🎥  Camera: " .. (CONFIG.SYNC_CAMERA and "ON" or "OFF")
    syncBtn.TextColor3 = T.Text
    syncBtn.Font = Enum.Font.GothamMedium
    syncBtn.TextSize = 12
    syncBtn.Parent = opts2
    applyCorner(syncBtn, 8)
    syncBtn.MouseButton1Click:Connect(function()
        CONFIG.SYNC_CAMERA = not CONFIG.SYNC_CAMERA
        syncBtn.Text = "🎥  Camera: " .. (CONFIG.SYNC_CAMERA and "ON" or "OFF")
        TweenService:Create(syncBtn, TweenInfo.new(0.15), {BackgroundColor3 = CONFIG.SYNC_CAMERA and T.Success or T.BgElevated}):Play()
    end)

    -- ====== Linha de ações (Teleport, Save, Load) ======
    local actions = Instance.new("Frame")
    actions.Size = UDim2.new(1, -24, 0, 34)
    actions.Position = UDim2.new(0, 12, 0, 254)
    actions.BackgroundTransparency = 1
    actions.Parent = parent

    local tpStart = Instance.new("TextButton")
    tpStart.Size = UDim2.new(0.24, -3, 1, 0)
    tpStart.Position = UDim2.new(0, 0, 0, 0)
    tpStart.BackgroundColor3 = T.BgElevated
    tpStart.Text = "⏮  Início"
    tpStart.TextColor3 = T.Text
    tpStart.Font = Enum.Font.GothamMedium
    tpStart.TextSize = 11
    tpStart.Parent = actions
    applyCorner(tpStart, 8)
    tpStart.MouseButton1Click:Connect(teleportToStart)

    local tpEnd = Instance.new("TextButton")
    tpEnd.Size = UDim2.new(0.24, -3, 1, 0)
    tpEnd.Position = UDim2.new(0.25, 0, 0, 0)
    tpEnd.BackgroundColor3 = T.BgElevated
    tpEnd.Text = "⏭  Fim"
    tpEnd.TextColor3 = T.Text
    tpEnd.Font = Enum.Font.GothamMedium
    tpEnd.TextSize = 11
    tpEnd.Parent = actions
    applyCorner(tpEnd, 8)
    tpEnd.MouseButton1Click:Connect(teleportToEnd)

    local saveBtn = Instance.new("TextButton")
    saveBtn.Size = UDim2.new(0.24, -3, 1, 0)
    saveBtn.Position = UDim2.new(0.5, 0, 0, 0)
    saveBtn.BackgroundColor3 = T.BgElevated
    saveBtn.Text = "💾  Salvar"
    saveBtn.TextColor3 = T.Text
    saveBtn.Font = Enum.Font.GothamMedium
    saveBtn.TextSize = 11
    saveBtn.Parent = actions
    applyCorner(saveBtn, 8)
    saveBtn.MouseButton1Click:Connect(saveRoute)

    local loadBtn = Instance.new("TextButton")
    loadBtn.Size = UDim2.new(0.24, -3, 1, 0)
    loadBtn.Position = UDim2.new(0.75, 0, 0, 0)
    loadBtn.BackgroundColor3 = T.BgElevated
    loadBtn.Text = "📂  Carregar"
    loadBtn.TextColor3 = T.Text
    loadBtn.Font = Enum.Font.GothamMedium
    loadBtn.TextSize = 11
    loadBtn.Parent = actions
    applyCorner(loadBtn, 8)
    loadBtn.MouseButton1Click:Connect(loadRoute)

    -- ====== Label de keyframes ======
    frameCounterLabel = Instance.new("TextLabel")
    frameCounterLabel.Size = UDim2.new(1, -24, 0, 20)
    frameCounterLabel.Position = UDim2.new(0, 12, 0, 296)
    frameCounterLabel.BackgroundTransparency = 1
    frameCounterLabel.Text = "Keyframes: 0"
    frameCounterLabel.TextColor3 = T.TextDim
    frameCounterLabel.Font = Enum.Font.GothamMedium
    frameCounterLabel.TextSize = 11
    frameCounterLabel.TextXAlignment = Enum.TextXAlignment.Left
    frameCounterLabel.Parent = parent

    statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(1, -24, 0, 20)
    statusLabel.Position = UDim2.new(0, 12, 0, 320)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Text = "Pronto"
    statusLabel.TextColor3 = T.TextDim
    statusLabel.Font = Enum.Font.Gotham
    statusLabel.TextSize = 10
    statusLabel.TextXAlignment = Enum.TextXAlignment.Left
    statusLabel.Parent = parent
end
