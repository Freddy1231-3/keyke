    -- ==================== FUNÇÕES AUXILIARES ====================
    local function notify(title, text, duration)
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = title, Text = text, Duration = duration or 3,
            })
        end)
    end

    local function simulateKeyPress(keyCode, holdDuration)
        holdDuration = holdDuration or 0
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        if holdDuration > 0 then task.wait(holdDuration) end
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end

    -- ==================== AUTO JJ'S ====================
    local function startAutoJJ()
        if CONFIG.AUTO_JJ_ENABLED then return end
        CONFIG.AUTO_JJ_ENABLED = true
        notify("Auto JJ's", "Ativado!", 2)
        autoJJThread = task.spawn(function()
            while CONFIG.AUTO_JJ_ENABLED do
                for _, key in ipairs(CONFIG.AUTO_JJ_KEYS) do
                    if not CONFIG.AUTO_JJ_ENABLED then break end
                    simulateKeyPress(key, 0.05)
                    task.wait(CONFIG.AUTO_JJ_DELAY)
                end
            end
        end)
    end

    local function stopAutoJJ()
        CONFIG.AUTO_JJ_ENABLED = false
        autoJJThread = nil
        notify("Auto JJ's", "Desativado.", 2)
    end

    -- ==================== GRAVADOR DE ROTA AVANÇADO ====================
    local function startRecording()
        if CONFIG.RECORDING then return end
        CONFIG.RECORDING = true
        recordedData = {}
        lastRecordTime = tick()
        notify("Gravador", "Gravando rota... Mova-se!", 2)
        recordingConnection = RunService.Heartbeat:Connect(function()
            if not CONFIG.RECORDING then return end
            local now = tick()
            if now - lastRecordTime >= CONFIG.RECORD_INTERVAL then
                lastRecordTime = now
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local frame = {
                        time = now,
                        position = hrp.Position,
                        rotation = hrp.CFrame.LookVector,
                        velocity = hrp.Velocity,
                        keys = {},
                    }
                    for _, key in ipairs(CONFIG.AUTO_JJ_KEYS) do
                        if UserInputService:IsKeyDown(key) then
                            table.insert(frame.keys, key)
                        end
                    end
                    table.insert(recordedData, frame)
                end
            end
        end)
    end

    local function stopRecording()
        if not CONFIG.RECORDING then return end
        CONFIG.RECORDING = false
        if recordingConnection then recordingConnection:Disconnect(); recordingConnection = nil end
        notify("Gravador", "Gravação finalizada! " .. #recordedData .. " frames.", 3)
    end

    local function startPlayback()
        if CONFIG.PLAYING or #recordedData == 0 then
            if #recordedData == 0 then notify("Gravador", "Nenhuma rota gravada!", 3) end
            return
        end
        CONFIG.PLAYING = true
        currentPlaybackIndex = 1
        playbackStartTime = tick()
        if CONFIG.AUTO_JJ_ENABLED then stopAutoJJ() end
        notify("Gravador", "Reproduzindo rota...", 2)

        if CONFIG.NOCLIP_ENABLED then
            noclipConnection = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end)
        end

        playbackConnection = RunService.Heartbeat:Connect(function()
            if not CONFIG.PLAYING then return end
            if currentPlaybackIndex > #recordedData then
                if CONFIG.LOOP_PLAYBACK then
                    currentPlaybackIndex = 1
                    playbackStartTime = tick()
                else
                    stopPlayback(); return
                end
            end
            local frame = recordedData[currentPlaybackIndex]
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                local targetCF = CFrame.new(frame.position, frame.position + frame.rotation)
                if CONFIG.PLAYBACK_SPEED ~= 1.0 then
                    local elapsed = tick() - playbackStartTime
                    local expectedFrame = math.floor(elapsed / CONFIG.RECORD_INTERVAL * CONFIG.PLAYBACK_SPEED) + 1
                    if expectedFrame > currentPlaybackIndex then
                        currentPlaybackIndex = math.min(expectedFrame, #recordedData)
                        frame = recordedData[currentPlaybackIndex]
                        targetCF = CFrame.new(frame.position, frame.position + frame.rotation)
                    end
                end
                hrp.CFrame = targetCF
                hrp.Velocity = frame.velocity
            end
            if CONFIG.SYNC_CAMERA then
                local camera = workspace.CurrentCamera
                if camera then
                    camera.CFrame = CFrame.new(frame.position, frame.position + frame.rotation)
                end
            end
            for _, key in ipairs(frame.keys) do
                simulateKeyPress(key, 0.05)
            end
            currentPlaybackIndex = currentPlaybackIndex + 1
        end)
    end

    local function stopPlayback()
        CONFIG.PLAYING = false
        if playbackConnection then playbackConnection:Disconnect(); playbackConnection = nil end
        if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end
        notify("Gravador", "Reprodução parada.", 2)
    end

    local function saveRoute()
        if #recordedData == 0 then notify("Gravador", "Nada para salvar!", 3); return end
        local success, err = pcall(function()
            local json = game:GetService("HttpService"):JSONEncode(recordedData)
            writefile("route_recorder.json", json)
        end)
        if success then
            notify("Gravador", "Rota salva!", 3)
        else
            notify("Gravador", "Erro ao salvar: " .. tostring(err), 3)
        end
    end

    local function loadRoute()
        local success, data = pcall(function()
            if isfile and isfile("route_recorder.json") then
                local content = readfile("route_recorder.json")
                return game:GetService("HttpService"):JSONDecode(content)
            end
            return nil
        end)
        if success and data and #data > 0 then
            recordedData = data
            notify("Gravador", "Rota carregada! " .. #recordedData .. " frames.", 3)
        else
            notify("Gravador", "Nenhum arquivo encontrado.", 3)
        end
    end

    -- ==================== AIMBOT ====================
    local function getClosestTarget()
        local camera = workspace.CurrentCamera
        if not camera then return nil end
        local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local closest, shortestDist = nil, CONFIG.AIMBOT_FOV
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if CONFIG.AIMBOT_TEAM_CHECK and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then continue end
            local char = player.Character
            if not char then continue end
            local part = char:FindFirstChild(CONFIG.AIMBOT_TARGET_PART)
            if not part then continue end
            local screenPos, onScreen = camera:WorldToScreenPoint(part.Position)
            if not onScreen then continue end
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                closest = part
            end
        end
        return closest
    end

    local function startAimbot()
        if CONFIG.AIMBOT_ENABLED then return end
        CONFIG.AIMBOT_ENABLED = true
        notify("Aimbot", "Ativado! FOV: " .. CONFIG.AIMBOT_FOV, 2)
        aimbotConnection = RunService.RenderStepped:Connect(function()
            if not CONFIG.AIMBOT_ENABLED then return end
            local target = getClosestTarget()
            if target then
                local camera = workspace.CurrentCamera
                local currentCF = camera.CFrame
                local goalCF = CFrame.new(currentCF.Position, target.Position)
                if CONFIG.AIMBOT_SMOOTHNESS > 0 then
                    camera.CFrame = currentCF:Lerp(goalCF, 1 - CONFIG.AIMBOT_SMOOTHNESS)
                else
                    camera.CFrame = goalCF
                end
            end
        end)
    end

