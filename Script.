    -- ==================== TOGGLE DO MENU (TECLA P) ====================
    local function setupMenuToggle()
        UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.KeyCode == CONFIG.TOGGLE_KEY then
                if mainWindow then
                    menuVisible = not menuVisible
                    mainWindow.Visible = menuVisible
                    if fovCircle then fovCircle.Visible = menuVisible and CONFIG.AIMBOT_SHOW_FOV and CONFIG.AIMBOT_ENABLED end
                end
            end
        end)
    end

    -- ==================== INICIALIZAÇÃO ====================
    createWindow()
    createFOVCircle()
    setupMenuToggle()
    notify("Script Carregado", "Interface Octernal com Recorder Avançado! Pressione P para ocultar.", 5)

end) -- fim do callback do Key System
