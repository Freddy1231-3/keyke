        AIMBOT_TEAM_CHECK = true,
        AIMBOT_SHOW_FOV = true,

        TOGGLE_KEY = Enum.KeyCode.P,
    }

    -- ==================== VARIÁVEIS GLOBAIS ====================
    local recordedData = {}
    local lastRecordTime = 0
    local currentPlaybackIndex = 1
    local playbackStartTime = 0
    local playbackConnection = nil
    local recordingConnection = nil
    local autoJJThread = nil
    local aimbotConnection = nil
    local fovCircle = nil
